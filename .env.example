# Copie para .env e ajuste. Nenhuma variável é obrigatória.

# Caminho do banco SQLite (no Docker o padrão é /data/linhamestre.db, em volume).
LINHAMESTRE_DB_PATH=linhamestre.db

# Administrador criado no primeiro boot, se o banco não tiver usuários.
# Sem senha definida, uma senha aleatória é gerada e exibida UMA vez no log.
LINHAMESTRE_ADMIN_USERNAME=admin
LINHAMESTRE_ADMIN_PASSWORD=

# Fuso horário usado para "hoje", prazos e validade.
LINHAMESTRE_TZ=America/Sao_Paulo

# Logs: DEBUG|INFO|WARNING|ERROR e formato json|text.
LINHAMESTRE_LOG_LEVEL=INFO
LINHAMESTRE_LOG_FORMAT=json

# Bloqueio de login após falhas consecutivas.
LINHAMESTRE_MAX_LOGIN_ATTEMPTS=5
LINHAMESTRE_LOCKOUT_MINUTES=15

# Senha dos usuários de demonstração criados por `linhamestre-seed --with-demo-users`.
LINHAMESTRE_DEMO_PASSWORD=
